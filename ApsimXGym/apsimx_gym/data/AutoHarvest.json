{
    "$type": "Models.Manager, Models",
    "CodeArray": [
        "using APSIM.Shared.Utilities;",
        "using Models.Utilities;",
        "using Models.Soils;",
        "using Models.PMF;",
        "using Models.Core;",
        "using System;",
        "using System.Linq;",
        "",
        "namespace Models",
        "{",
        "    [Serializable] ",
        "    public class Script : Model",
        "    {",
        "        [Description(\"Crop\")]",
        "        public IPlant Crop { get; set; }",
        "        ",
        "        [EventSubscribe(\"DoManagement\")]",
        "        private void OnDoManagement(object sender, EventArgs e)",
        "        {",
        "            if (Crop.IsReadyForHarvesting)",
        "            {",
        "                Crop.Harvest();",
        "                Crop.EndCrop();",
        "            }",
        "        }",
        "    }",
        "}",
        "       "
    ],
    "Parameters": [
        {
            "Key": "Crop",
            "Value": "Wheat"
        }
    ],
    "Name": "AutoHarvest CROP",
    "ResourceName": null,
    "Children": [],
    "Enabled": true,
    "ReadOnly": false
